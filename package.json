{
  "name": "compass",
  "productName": "Compass",
  "version": "1.0.1",
  "main": "frontend/main/main.js",
  "scripts": {
    "setup": "python -m venv .venv && .venv\\Scripts\\pip install -r backend\\requirements.txt && npm install",
    "setup:backend": "python -m venv .venv && .venv\\Scripts\\pip install -r backend\\requirements.txt",
    "setup:frontend": "npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && set PYTHONPATH=src && ..\\.venv\\Scripts\\python.exe src\\compass\\app.py",
    "dev:frontend": "concurrently \"npm run watch\" \"npm run start\"",
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron .",
    "watch": "npx webpack --watch",
    "build": "webpack --mode production",
    "clean": "rimraf dist/ build/",
    "build:backend": ".venv\\Scripts\\python.exe -m PyInstaller --clean --noconfirm backend\\compass_backend.spec --distpath backend\\dist --workpath backend\\build",
    "package-win": "npm run clean && npm run build && electron-builder build --win --publish never",
    "dist:win": "npm run build:backend && npm run package-win",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "desktop-agent",
    "sap2000",
    "computer-use",
    "engineering-software",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "description": "Open-source Windows desktop AI agent for GUI-heavy engineering and professional software.",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@electron/remote": "^2.1.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@headlessui/react": "^2.2.0",
    "@monaco-editor/react": "^4.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@xterm/xterm": "^5.5.0",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^3.2.1",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6",
    "react-icons": "^4.12.0",
    "react-markdown": "^9.1.0",
    "react-resizable": "^3.0.5",
    "react-rnd": "^10.4.14",
    "react-router-dom": "^7.1.1",
    "react-tabs": "^6.1.0",
    "rimraf": "^6.0.1",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.4",
    "socket.io-client": "^4.8.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "uuid": "^11.0.5",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "xterm": "^5.3.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "build": {
    "appId": "com.compass.app",
    "productName": "Compass",
    "files": [
      "frontend/**/*",
      "package.json",
      "!frontend/renderer/dist/**/*.map",
      "!**/node_modules/**/{test,__tests__,tests,powered-test,example,examples}",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}"
    ],
    "extraResources": [
      {
        "from": "backend/dist/Compass Backend",
        "to": "backend/Compass Backend"
      },
      {
        "from": "resources/compass.png",
        "to": "compass.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/compass.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Compass-Setup-${version}.${ext}"
    }
  }
}
