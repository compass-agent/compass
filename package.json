{
  "name": "compass",
  "version": "1.0.0",
  "main": "frontend/main/main.js",
  "scripts": {
    "start": "electron .",
    "watch": "npx webpack --watch",
    "build": "webpack --mode production",
    "package": "npm run build && electron-builder build --mac",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"npm run watch\" \"npm run start\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@electron/remote": "^2.1.2",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.1.0",
    "css-loader": "^7.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "style-loader": "^4.0.0",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1"
  },
  "build": {
    "appId": "com.yourcompany.compass",
    "productName": "Compass",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "files": [
      "frontend/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
