{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "strict": true,
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist"
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx", "frontend/main/constants.js"],
  "exclude": ["node_modules", "dist"]
}
